# Copy to .env — docker compose reads it automatically.

# Postgres
POSTGRES_USER=blew
POSTGRES_PASSWORD=blew
POSTGRES_DB=blew
# Host port for the database (dev override only)
POSTGRES_PORT=5432

# Host ports
API_PORT=8080
WEB_PORT=3000

# Browser origin allowed to call the API directly (Next.js itself calls it server-side)
CORS_ORIGIN=http://localhost:3000

# Empty = ignore X-Forwarded-For. Next.js requests share an API-side IP budget.
# Set only behind an edge proxy that overwrites X-Forwarded-For and prevents
# direct access to Next.js/API. Include the Next.js peer and trusted edge CIDRs.
TRUSTED_PROXY_CIDRS=

# Production Web Push contact: set your real public https:// URL or mailto: address.
# Safari push requires a non-localhost subject. Keys are stored in PostgreSQL.
WEB_PUSH_SUBJECT=https://localhost

# Per-bot scheduler: generate a private value with `openssl rand -hex 32`.
# Shared only by API and web. Empty disables scheduled dispatch.
SCHEDULER_SECRET=

# Private local memory service authentication (at least 32 random characters)
MEMORY_SECRET=
